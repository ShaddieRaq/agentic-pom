{
  "name": "@playwright-elements/crawler",
  "version": "0.1.0",
  "private": true,
  "description": "AI-agent-driven Playwright Page Object generator. The pw-crawl CLI explores a live web app with a Claude tool-use loop and emits typed TypeScript page objects, navigation helpers, and an API-dependency manifest.",
  "license": "MIT",
  "homepage": "https://github.com/ShaddieRaq/agentic-pom/tree/main/tools/crawler",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShaddieRaq/agentic-pom.git",
    "directory": "tools/crawler"
  },
  "bugs": {
    "url": "https://github.com/ShaddieRaq/agentic-pom/issues"
  },
  "author": "Rashad Colebrooke",
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "bin": {
    "pw-crawl": "./dist/bin/pw-crawl.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:unit": "playwright test --config=playwright.unit.config.ts",
    "test:validation": "playwright test tests/validation.spec.ts",
    "test:drift": "playwright test tests/drift-check.spec.ts",
    "save-baselines": "npm run build && node dist/scripts/save-baselines.js",
    "check-drift": "./scripts/check-drift.sh"
  },
  "dependencies": {
    "playwright": "~1.60.0"
  },
  "devDependencies": {
    "@playwright/test": "~1.58.0",
    "@types/node": "~20.19.0",
    "esbuild": "~0.27.4",
    "tsx": "~4.21.0",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "^0.0.75"
  },
  "keywords": [
    "playwright",
    "page-object",
    "page-object-model",
    "pom",
    "ai-agent",
    "agentic",
    "claude",
    "anthropic",
    "mcp",
    "model-context-protocol",
    "test-generation",
    "code-generation",
    "browser-automation",
    "crawler",
    "e2e",
    "end-to-end",
    "testing",
    "playwright-elements"
  ]
}
